"use client";

import type { UiDensity } from "@/lib/db/schema/enums";
import { worstCondition, type AppCondition } from "@/lib/docker/conditions";
import { apps } from "@/lib/db/schema";
import { listApps } from "@/lib/app-services/apps";

export function Panel({ density, conditions }: { density: UiDensity; conditions: AppCondition[] }) {
  return <div data-density={density}>{String(worstCondition(conditions))}{String(apps)}{String(listApps)}</div>;
}
