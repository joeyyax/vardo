# =============================================================================
# Vardo — Environment Variables
# =============================================================================
# These are infrastructure connection strings and build-time settings only.
# Application configuration (email, backups, GitHub) is managed via
# vardo.yml / vardo.secrets.yml or the admin UI. Feature flags can be set from
# any of the three — see the Feature flags section below.
#
# Copy to .env and fill in values. install.sh generates this automatically.
# =============================================================================

# ---------------------
# Environment
# ---------------------
# Omit COMPOSE_PROFILES for dev (app container skipped, use pnpm dev).
# Set COMPOSE_PROFILES=production for full stack (install.sh does this).
# COMPOSE_PROFILES=production
TRAEFIK_LOG_LEVEL=INFO

# ---------------------
# Traefik
# ---------------------
# Docker network filter for Traefik container discovery.
#   vardo-network  = default — only discover Vardo-managed containers (recommended)
#   (empty string) = no filter — discover all containers with traefik.enable=true
# Change via Admin → Settings → Traefik, then restart the Traefik container.
TRAEFIK_DOCKER_NETWORK=vardo-network

# ---------------------
# Database & Cache
# ---------------------
DATABASE_URL=postgresql://host:host@localhost:7100/host
REDIS_URL=redis://localhost:7200

# ---------------------
# Auth
# ---------------------
BETTER_AUTH_SECRET=vardo-dev-secret-change-in-production
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------
# Encryption
# ---------------------
# Generate with: openssl rand -hex 32
ENCRYPTION_MASTER_KEY=

# ---------------------
# Instance Identity
# ---------------------
VARDO_INSTANCE_ID=
VARDO_DOMAIN=localhost
# VARDO_HOME_DIR=/opt/vardo  # Root directory for all Vardo data. Accepts VARDO_DIR as fallback.
# VARDO_PROJECTS_DIR=       # App deployment files. Default: $VARDO_HOME_DIR/apps
# VARDO_IMAGES_DIR=         # Docker image storage. Default: $VARDO_HOME_DIR/images

# ---------------------
# Host Mounts
# ---------------------
# Optional host paths to mount into Vardo. Manage via Admin → Settings → Maintenance.
# VARDO_DATA=             # General data directory (e.g., /mnt/data)
# VARDO_PROJECTS=         # Compose projects directory for git auto-detection (e.g., /home/user/projects)
# VARDO_MOUNT_1=          # Extra mount slot 1
# VARDO_MOUNT_2=          # Extra mount slot 2

# ---------------------
# TLS (production only)
# ---------------------
# ACME_EMAIL=you@example.com
# ZEROSSL_EAB_KID=
# ZEROSSL_EAB_HMAC=
# CF_DNS_API_TOKEN=    # Cloudflare API token for DNS-01 challenge (Zone:DNS:Edit permission)

# ---------------------
# Self-Management (optional)
# ---------------------
# Enable via Admin → Settings → Features → selfManagement.
# VARDO_HOME_DIR must be set so startup registration can find docker-compose.yml.
# VARDO_HOME_DIR=/opt/vardo
#
# Docker network that preview containers join. Must match the network created
# by your Vardo docker-compose.yml. Defaults to "vardo-network".
# VARDO_NETWORK=vardo-network
#
# Required for previews. A preview runs PR code with write access to whatever
# database it is handed, so preview creation is refused until this points at an
# isolated one.
# PREVIEW_DATABASE_URL=postgresql://preview_user:pass@localhost:7100/preview
# PREVIEW_REDIS_URL=redis://localhost:7200/1
#
# Accepts the risk and lets previews use the production database.
# VARDO_ALLOW_PREVIEW_PROD_DB=true

# ---------------------
# Sign-in methods (optional)
# ---------------------
# Moved out of the feature flags below — each method is now switchable on
# Admin -> Settings -> Authentication. VARDO_FEATURE_PASSWORD_AUTH still pins
# the password method as an alias, so existing pins keep working.
#
# Resolution order, highest first: env var > vardo.yml (auth.methods) >
# admin UI (database) > built-in default (on). Same value parsing as the flags
# below. At least one method has to stay usable; the admin page refuses the
# write that would disable the last one.
#
# VARDO_AUTH_PASSWORD=true                 # email/password sign-in
# VARDO_AUTH_PASSKEY=true                  # WebAuthn passkeys
# VARDO_AUTH_MAGIC_LINK=true               # emailed one-time sign-in links
# VARDO_AUTH_TOTP=true                     # authenticator app second factor
# VARDO_AUTH_GITHUB=true                   # GitHub OAuth sign-in

# ---------------------
# Feature flags (optional)
# ---------------------
# Resolution order, highest first: env var > vardo.yml > admin UI (database) >
# built-in default. Anything pinned by an env var or vardo.yml shows on
# Admin -> Settings -> Feature flags as read-only, naming the source.
#
# Naming: VARDO_FEATURE_<NAME>, where <NAME> is the flag upper-snake-cased —
# hyphens become underscores and camelCase word boundaries gain one.
#   error-tracking -> VARDO_FEATURE_ERROR_TRACKING
#   bindMounts     -> VARDO_FEATURE_BIND_MOUNTS
# Accepts 1/true/yes/on/enabled and 0/false/no/off/disabled. Unset means "not
# pinned"; an unparseable value is ignored. Changes need a restart.
#
# Access
# VARDO_FEATURE_UI=true                    # web dashboard; off leaves only /api/v1/
# VARDO_FEATURE_API_TOKENS=true            # bearer token auth for /api/v1/ and MCP
# VARDO_FEATURE_TEAMS=true                 # team page, invitations, roles, org switcher
#
# Deployment
# VARDO_FEATURE_ENVIRONMENTS=true          # staging/preview environments per app
# VARDO_FEATURE_PREVIEWS=true              # ephemeral PR preview environments
# VARDO_FEATURE_GIT_INTEGRATION=true       # GitHub OAuth, deploy keys, PR previews
# VARDO_FEATURE_CONTAINER_IMPORT=true      # adopt containers already on the host
# VARDO_FEATURE_SELF_MANAGEMENT=false      # manage Vardo itself as a project
# VARDO_FEATURE_TEMPLATES=true             # starter templates on the New app page
#
# Observability
# VARDO_FEATURE_METRICS=true               # cAdvisor container metrics
# VARDO_FEATURE_LOGGING=true               # Loki log aggregation
# VARDO_FEATURE_IMAGE_UPDATES=true         # poll registries for newer image tags
# VARDO_FEATURE_MONITORING=true            # background health checks
# VARDO_FEATURE_DOMAIN_MONITORING=true     # DNS and certificate expiry checks
# VARDO_FEATURE_SECURITY=true              # port, header and TLS scans
# VARDO_FEATURE_ACTIVITY=true              # activity log page and its writes
# VARDO_FEATURE_AWAY=true                  # "while you were away" summary
#
# Operations
# VARDO_FEATURE_BACKUPS=true               # scheduled backups
# VARDO_FEATURE_CRON=true                  # scheduled tasks for apps
# VARDO_FEATURE_TERMINAL=true              # web terminal into containers
# VARDO_FEATURE_NOTIFICATIONS=true         # email, webhook and Slack alerts
# VARDO_FEATURE_DIGEST=true                # weekly summary email
#
# Networking
# VARDO_FEATURE_SSL=true                   # automatic TLS certificates
# VARDO_FEATURE_MESH=true                  # WireGuard links between instances
#
# Advanced
# VARDO_FEATURE_MCP=true                   # MCP endpoint at /api/mcp; needs API tokens
# VARDO_FEATURE_HOOKS=false                # lifecycle hooks; script hooks run host commands
# VARDO_FEATURE_BIND_MOUNTS=false          # allow host path mounts in compose
# VARDO_FEATURE_DOCKER_SOCKET=false        # allow mounting /var/run/docker.sock

# ---------------------
# Analytics (optional)
# ---------------------
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# NEXT_PUBLIC_PLAUSIBLE_SRC=

# ---------------------
# Health probe targets (optional)
# ---------------------
# Defaults in docker-compose.yml point at the service names on vardo-network.
# Set these when running the app outside the compose stack.
# CADVISOR_URL=http://localhost:7300
# LOKI_URL=http://localhost:7400
# TRAEFIK_URL=http://localhost:8080
